    },
    {
      "id": "write-tree-check",
      "type": "character-writing",
      "instruction": "Write the character for tree without assistance.",
      "target": {
        "character": "木",
        "locale": "zh-CN"
      },
      "prompt": [
        { "type": "text", "text": "Write the character meaning tree.", "locale": "en-US" }
      ],
      "assessment": { "criteria": ["form", "stroke-order", "stroke-direction"] },
