{
  // Copy to app.settings.jsonc in this directory; that file is git-ignored.
  // Used only by npm run dev on localhost. Loading settings never calls providers.
  // Connections import independently on startup, only when not already saved.
  // Sections are optional. Remove aiConnection to leave AI setup manual.
  // Optional Mandarin speed: exactly 0.5, 0.75, 1, or 1.25. English stays at 1.
  // Reapplied on every startup when present: edit this value, then reload the app.
  // New conversations use this default; saved conversations keep their own speechRate.
  // Hear outside conversations uses this speed when no explicit rate is supplied.
  // Omit to keep the saved default; with no saved default, normal speed (1) is used.
  // Omitting the key never saves an implicit default. Saved connections still win below.
  // This non-secret preference is included in workspace backups. Loading never plays audio.
  "defaultSpeechRate": 0.5,

  // Optional per-language voices, reapplied on startup like defaultSpeechRate.
  // Omitted languages keep their saved choices; omitting this section changes nothing.
  // Use exact Edge catalog IDs. Loading these preferences never plays or sends text.
  // Edge playback needs the local dev server; a missing voice never silently switches.
  // Browser selections are also supported: use voiceURI, name, lang, and localService
  // from the browser voice's saved preference instead of provider/voice.
  // Uncomment to pin these voices; UI changes last until the next reload.
  // "speechVoices": {
  //   "zh-Hans": { "provider": "edge", "voice": "zh-CN-YunjianNeural" },
  //   "en-US": { "provider": "edge", "voice": "en-US-ChristopherNeural" }
  // },

  // Optional AI connection. Remove this section to leave AI setup manual.
  "aiConnection": {
    // "responses" uses /responses; "chat-completions" uses /chat/completions.
    // If omitted, existing settings continue to use Chat Completions.
    "apiType": "responses",

    // API root, not the full operation URL. Usually ends in /v1.
    // HTTPS is required except for a service running on localhost.
    "baseUrl": "https://api.openai.com/v1",

    // Provider credential. Use a restricted development key; never commit it.
    // The browser sends it only to the configured provider.
    "apiKey": "",

    // Model identifier recognized by your endpoint, not a display name.
    "model": "",

    // Enable only if the model supports native function calling.
    // App tools can look up words/lessons/progress but cannot change scores.
    "nativeTools": false,

    // Enable only if the endpoint supports strict JSON-schema output.
    // Otherwise the model is asked for JSON and replies are validated locally.
    "structuredOutput": false,

    // Set true to opt into saving this key in plaintext browser storage.
    // Same-origin code can access it; workspace backups exclude credentials.
    // Saved connections win: remove the saved connection and reload to reimport.
    "storageAcknowledged": true
  }

  // Optional Azure Speech connection for automatic pronunciation assessment.
  // Uncomment this section, including its leading comma, after filling its key and opting in.
  // Leaving it commented out does not block the separate AI connection import.
  // , "speechConnection": {
  //   // Azure Speech is separate from your AI provider and its credentials.
  //   "provider": "azure",
  //
  //   // Region identifier for your Azure Speech resource, such as eastus.
  //   "region": "eastus",
  //
  //   // Key from that Azure Speech resource. Use a restricted development key.
  //   "apiKey": "",
  //
  //   // Set true to save the key in plaintext browser storage on this origin.
  //   // Credentials are excluded from workspace backups.
  //   // A saved speech connection wins, even when AI is still unconfigured.
  //   // Remove the saved speech connection and reload to reimport file changes.
  //   // Remove this section too if you want speech assessment to stay unconfigured.
  //   "storageAcknowledged": true
  // }
  // Saving/importing does not validate the key, record audio, or call Azure.
  // Only explicit Practice recording with speech feedback enabled sends audio
  // and the reference text to Azure for assessment; provider charges may apply.
}
