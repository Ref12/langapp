// Static-assets Worker for the hexad deployment of LinguaWeave.
// Build first: npm run build:hexad  (emits dist-hexad/apps/langapp/).
// The route is added separately (see deploy/hexad/README.md), not from this file.
{
  "name": "langapp",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-hexad",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
